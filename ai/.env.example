BIZNO_API_KEY=
NTS_SERVICE_KEY=

# Vertex AI 직결 경로 (src/biz_number/vertex.py 전용).
# API 키 없이 ADC로 인증한다 — 먼저 `gcloud auth application-default login` 필요.
# 이 경로는 실행하는 사람의 구글 계정/GCP 결제 계정에 묶인다.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# 카카오 로컬 API (src/investigation/kakao_map.py — 2차 조사의 카카오맵 확인).
# 비워두면 지도 확인 없이 웹검색만 돈다. 응답은 저장하지 않고 place_url 만 근거로 남긴다.
KAKAO_REST_API_KEY=

# 지도 대조 (src/investigation/map_lookup.py). 기본은 꺼짐 — 끄면 지금처럼 웹검색만 돈다.
# 네이버 지역 검색은 NAVER API HUB(NCP) 키를 쓴다. 카카오 값은 저장·LLM 전송 불가라 수정안에 값 없이 근거·링크만 남는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_LOCAL_ENABLED=false
KAKAO_COMPARE_ENABLED=false

# 조사 에이전트 (src/investigation/agent.py). AGENT_ENABLED=true 면 지도로 확정되지 않은 가게를
# 에이전트가 이어서 조사한다(혼합 방식, 지도 대조와 함께 켠다). 판단 모델은 AGENT_MODEL, 비우면 Vertex Gemini.
# 웹검색은 그라운딩이 필요해 늘 Vertex 로 부른다 — 여기 모델은 도구를 고르는 판단에만 쓴다.
# 카테캠 프록시(OpenAI 호환 Responses API)는 모델마다 주소가 다르다 — AGENT_BASE_URL=https://mlapi.run/<uuid>/v1
# 쓸 수 있는 모델: gpt-6-luna · gemini-4-argon · claude-sonnet-5 (각 프록시의 /v1/models 로 확인)
AGENT_ENABLED=false
AGENT_MODEL=
AGENT_BASE_URL=
AGENT_API_KEY=
# 가게 하나에 쓸 시간(초). 백엔드가 AI 응답을 기다리는 시간(ai.read-timeout-ms, 기본 75초)과 맞춘다 — 넘으면 백엔드가 버린다.
# 남은 시간이 모자라면 에이전트가 새 검색을 시작하지 않고 모은 것으로 판정한다.
INVESTIGATION_TIME_BUDGET_SECONDS=75

# ── 백엔드 연동 ──────────────────────────────────────
# AI 가 호출할 백엔드 주소. docker compose 로 띄우면 서비스명(http://backend:8080)을 쓴다.
BACKEND_BASE_URL=http://localhost:8080
