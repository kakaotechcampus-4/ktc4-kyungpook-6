BIZNO_API_KEY=
NTS_SERVICE_KEY=

# 카테캠 프록시(mlapi.run)를 거쳐야 함 — API 직접 호출 아님.
# GOOGLE_API_KEY는 프록시가 발급하는 토큰, 
# GOOGLE_PROXY_URL은 그 프록시의 base URL (예: https://mlapi.run/<uuid>).
GOOGLE_API_KEY=
GOOGLE_PROXY_URL=

# eval/benchmark.py가 mock 외에 실제로 테스트할 모델 하나.
# 값은 eval/benchmark.py의 MODEL_FACTORIES에 등록된 이름 중 하나 (예: gemini-3.8-flash).
# 비워두면 mock만 돈다.
BENCHMARK_MODEL=
