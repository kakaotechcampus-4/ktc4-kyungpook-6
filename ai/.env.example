BIZNO_API_KEY=
NTS_SERVICE_KEY=

# 카테캠 프록시(mlapi.run). OpenAI 호환 /v1만 노출하고 구글 검색 그라운딩을 태울 수 없어
# (provider-executed 도구 거부) 지금 폴백 경로에는 쓰지 않는다.
# GOOGLE_API_KEY는 프록시가 발급하는 토큰, 
# GOOGLE_PROXY_URL은 그 프록시의 base URL (예: https://mlapi.run/<uuid>).
GOOGLE_API_KEY=
GOOGLE_PROXY_URL=

# Vertex AI 직결 경로 (src/biz_number/vertex.py 전용).
# API 키 없이 ADC로 인증한다 — 먼저 `gcloud auth application-default login` 필요.
# 이 경로는 실행하는 사람의 구글 계정/GCP 결제 계정에 묶인다.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# 카카오 로컬 API (src/investigation/kakao_map.py — 2차 조사의 카카오맵 확인).
# 비워두면 지도 확인 없이 웹검색만 돈다. 응답은 저장하지 않고 place_url 만 근거로 남긴다.
KAKAO_REST_API_KEY=

# 지도 대조 (src/investigation/map_lookup.py). 기본은 꺼짐 — 끄면 지금처럼 웹검색만 돈다.
# 네이버 지역 검색은 NAVER API HUB(NCP) 키를 쓴다. 카카오 값은 저장·LLM 전송 불가라 수정안에 값 없이 근거·링크만 남는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_LOCAL_ENABLED=false
KAKAO_COMPARE_ENABLED=false

# 조사 에이전트의 판단 모델 (src/investigation/agent.py). 비우면 Vertex Gemini.
# 웹검색은 그라운딩이 필요해 늘 Vertex 로 부른다 — 여기 모델은 도구를 고르는 판단에만 쓴다.
AGENT_MODEL=
AGENT_BASE_URL=
AGENT_API_KEY=

# ── 백엔드 연동 ──────────────────────────────────────
# AI 가 호출할 백엔드 주소. docker compose 로 띄우면 서비스명(http://backend:8080)을 쓴다.
BACKEND_BASE_URL=http://localhost:8080
