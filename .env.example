# 로컬에서 Frontend + Backend + DB를 한 번에 띄울 때(docker-compose.yml) 쓰는 예시입니다.
#   cp .env.example .env
#
# .env는 .gitignore에 의해 커밋되지 않습니다.
# 아래 기본값은 docker-compose.yml에도 fallback으로 박혀 있어서,
# .env 파일 없이 `docker compose up -d --build` 만 해도 그대로 동작합니다.
#
# 🚨 운영(prod) 값은 여기에 적지 마세요. 이 repo는 public이고,
#    운영 값은 배포 환경의 환경변수로만 주입합니다.
#
# dev 에서만 쓰는 값(외부에 여는 POSTGRES_PORT·AI_PORT, AI_BASE_URL)은 .env.development.example 에 있습니다.

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=ktc4
POSTGRES_USER=ktc4
POSTGRES_PASSWORD=ktc4local

# ── Backend (Spring Boot 데이터소스) ─────────────────────
DB_URL=jdbc:postgresql://postgres:5432/ktc4
DB_USERNAME=ktc4
DB_PASSWORD=ktc4local
BACKEND_PORT=8080

# ── Frontend ──────────────────────────────────────────
FRONTEND_PORT=3000
# 브라우저가 읽는 공개 주소입니다. frontend 를 빌드할 때 박히므로, 바꾸면 다시 빌드해야 합니다.
# PUBLIC_ 접두사는 "여기 들어간 값은 전 세계가 본다" 는 뜻입니다 — 내부망 주소를 넣지 마세요.
PUBLIC_BACKEND_URL=http://example.com
BACKEND_SWAGGER_URL=http://example.com/v3/api-docs

# ── AI → Backend (docker-compose.dev.yml 전용) ──────────
# AI 컨테이너가 백엔드를 부르는 주소입니다. 공개 주소와 쓰임이 달라 키를 따로 둡니다.
# base(docker-compose.yml)는 http://backend:8080 으로 고정이고, dev 에서만 이 값으로 바꿉니다.
BACKEND_BASE_URL=http://backend:8080

# ── Backend 인증·외부 API (docker-compose.dev.yml 전용) ──
# 아래 값은 base(docker-compose.yml)는 컨테이너에 넘기지 않고, dev 오버라이드만 넘깁니다.
#   scripts/deploy.sh dev up -d --build  → 아래 값이 backend 컨테이너에 들어감
#   docker compose up -d --build         → 들어가지 않음(관리자 계정·키 없이 동작 — 권한 검사는 늘 켜져 있음)
# 값이 비어 있어도 배포는 멈추지 않습니다 — 빈 값이 그대로 컨테이너에 들어갑니다.
# dev·prod 서버는 각 서버의 .env 로 값을 관리합니다. 여기엔 로컬용 값만 넣으세요.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
INTERNAL_API_KEY=
BIZNO_API_KEY=
NTS_SERVICE_KEY=

# ── AI 조사 (docker-compose.yml 의 ai 서비스) ────────────
# 🔴 아래 두 값이 없으면 **조사가 항상 503** 입니다. 배포는 성공하고 화면도 뜨는데 조사만
#    조용히 실패합니다 — ai/src/server/main.py 가 GOOGLE_CLOUD_PROJECT 가 없으면
#    UnavailableInvestigator 를 꽂습니다. 값이 비어도 compose 가 멈추지 않으니 티가 안 납니다.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Vertex 는 API 키가 아니라 **서비스 계정 JSON(ADC)** 으로 인증합니다(ai/.env.example 참고).
# 여기에는 그 파일의 **호스트 경로**를 적습니다 — compose 가 컨테이너 안
# /run/secrets/vertex.json 으로 읽기 전용 마운트합니다. 저장소 안에 두지 마세요.
# 배포(dev)는 이 파일을 GitHub Secrets(GCP_SA_KEY)에서 받아 ~/.ktc4/vertex.json 에 씁니다
# (.github/workflows/deploy-dev.yml). 그래서 서버 .env 를 고치지 않아도 됩니다.
VERTEX_KEY_PATH=

# 지도 확인·대조에 쓰는 키. 비우면 지도 없이 웹검색만 돕니다.
KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 스위치(#74) — 기본은 전부 꺼짐이고, 꺼진 동작은 이전과 같습니다.
# ⚠️ 지도 대조를 켜기 전에 ai/src/investigation/classify.py:84 의 _REGION_BEFORE_BRANCH 를
#    고쳐야 합니다. "대구왕갈비본점" → "왕갈비본점" 으로 잘려서, 그 열쇠를 쓰는
#    map_lookup.same_store() 가 같은 구 안의 **다른 가게** 주소·전화를 관측으로 끌어옵니다.
NAVER_LOCAL_ENABLED=false
KAKAO_COMPARE_ENABLED=false
AGENT_ENABLED=false
# 에이전트의 판단 모델. 비우면 Vertex Gemini 를 그대로 씁니다(그때 아래 둘은 안 읽힙니다).
AGENT_MODEL=
AGENT_BASE_URL=
AGENT_API_KEY=
# 가게 하나에 쓸 시간(초). 백엔드의 ai.read-timeout-ms(기본 75초)와 맞춥니다.
INVESTIGATION_TIME_BUDGET_SECONDS=75
