# 로컬에서 Frontend + Backend + DB를 한 번에 띄울 때(docker-compose.yml) 쓰는 예시입니다.
#   cp .env.example .env
#
# .env는 .gitignore에 의해 커밋되지 않습니다.
# 아래 기본값은 docker-compose.yml에도 fallback으로 박혀 있어서,
# .env 파일 없이 `docker compose up -d --build` 만 해도 그대로 동작합니다.
#
# 🚨 운영(prod) 값은 여기에 적지 마세요. 이 repo는 public이고,
#    운영 값은 배포 환경의 환경변수로만 주입합니다.
#
# dev 에서만 쓰는 값(외부에 여는 POSTGRES_PORT·AI_PORT, AI_BASE_URL)은 .env.development.example 에 있습니다.

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=ktc4
POSTGRES_USER=ktc4
POSTGRES_PASSWORD=ktc4local

# ── Backend (Spring Boot 데이터소스) ─────────────────────
DB_URL=jdbc:postgresql://postgres:5432/ktc4
DB_USERNAME=ktc4
DB_PASSWORD=ktc4local
BACKEND_PORT=8080

# ── Frontend ──────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_BASE_URL=http://example.com
BACKEND_SWAGGER_URL=http://example.com/v3/api-docs

# ── Backend 인증·외부 API (docker-compose.dev.yml 전용) ──
# 아래 값은 base(docker-compose.yml)는 컨테이너에 넘기지 않고, dev 오버라이드만 넘깁니다.
#   scripts/deploy.sh dev up -d --build  → 아래 값이 backend 컨테이너에 들어감
#   docker compose up -d --build         → 들어가지 않음(관리자 계정·키 없이 동작 — 권한 검사는 늘 켜져 있음)
# 값이 비어 있어도 배포는 멈추지 않습니다 — 빈 값이 그대로 컨테이너에 들어갑니다.
# dev·prod 서버는 각 서버의 .env 로 값을 관리합니다. 여기엔 로컬용 값만 넣으세요.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
INTERNAL_API_KEY=
BIZNO_API_KEY=
NTS_SERVICE_KEY=
