# 로컬에서 한 번에 띄울 때 쓰는 예시입니다.  cp .env.example .env
#
# 🚨 운영(prod) 값은 여기에 적지 마세요. 이 repo 는 public 입니다.
#
# 각 값이 무엇이고 없으면 어떻게 되는지는 docs/배포환경에서_작업하는_방법.md 를 보세요.
# dev 전용 값(POSTGRES_PORT·AI_PORT·AI_BASE_URL)은 .env.development.example 에 있습니다.

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=ktc4
POSTGRES_USER=ktc4
POSTGRES_PASSWORD=ktc4local

# ── 컨테이너 포트를 어느 주소에 여는가 ───────────────────
BIND_HOST=0.0.0.0

# ── Backend (Spring Boot 데이터소스) ─────────────────────
DB_URL=jdbc:postgresql://postgres:5432/ktc4
DB_USERNAME=ktc4
DB_PASSWORD=ktc4local
BACKEND_PORT=8080

# ── Frontend ──────────────────────────────────────────
# PUBLIC_BACKEND_URL 은 브라우저가 읽는 주소입니다. 빌드할 때 번들에 박힙니다.
FRONTEND_PORT=3000
PUBLIC_BACKEND_URL=http://example.com
BACKEND_SWAGGER_URL=http://example.com/v3/api-docs

# ── AI → Backend ──────────────────────────────────────
# 위 공개 주소와 다릅니다. AI 컨테이너가 백엔드를 부르는 내부 주소입니다.
BACKEND_BASE_URL=http://backend:8080

# ── Backend 인증·외부 API (dev 오버라이드에서만 컨테이너로 들어갑니다) ──
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
INTERNAL_API_KEY=
BIZNO_API_KEY=
NTS_SERVICE_KEY=

# ── AI 조사 ───────────────────────────────────────────
# 🔴 GOOGLE_CLOUD_PROJECT 와 VERTEX_KEY_PATH 가 없으면 조사가 항상 503 입니다(배포는 성공합니다).
# VERTEX_KEY_PATH 는 서비스 계정 JSON 의 호스트 경로입니다. 저장소 안에 두지 마세요.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_KEY_PATH=

# 웹검색 제공자: 비우면 vertex(구글 그라운딩). claude 면 ANTHROPIC_API_KEY 가 있어야 하고, 위 GCP 값은
# 에이전트 판단을 Gemini 로 할 때(AGENT_ENABLED=true, AGENT_MODEL 비움)만 필요합니다.
WEB_SEARCH_PROVIDER=
ANTHROPIC_API_KEY=

KAKAO_REST_API_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 2차 조사 스위치 (#74) ──────────────────────────────
# NAVER_LOCAL_ENABLED 는 켜지 않습니다 — 약관. docs/배포환경에서_작업하는_방법.md 를 보세요.
NAVER_LOCAL_ENABLED=false
KAKAO_COMPARE_ENABLED=false
AGENT_ENABLED=false
AGENT_MODEL=
AGENT_BASE_URL=
AGENT_API_KEY=
INVESTIGATION_TIME_BUDGET_SECONDS=75
