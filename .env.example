# 로컬에서 Frontend + Backend + DB를 한 번에 띄울 때(docker-compose.yml) 쓰는 예시입니다.
#   cp .env.example .env
#
# .env는 .gitignore에 의해 커밋되지 않습니다.
# 아래 기본값은 docker-compose.yml에도 fallback으로 박혀 있어서,
# .env 파일 없이 `docker compose up -d --build` 만 해도 그대로 동작합니다.
#
# 🚨 운영(prod) 값은 여기에 적지 마세요. 이 repo는 public이고,
#    운영 값은 배포 환경의 환경변수로만 주입합니다.

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=ktc4
POSTGRES_USER=ktc4
POSTGRES_PASSWORD=ktc4local
POSTGRES_PORT=5432

# ── Backend (Spring Boot 데이터소스) ─────────────────────
DB_URL=jdbc:postgresql://postgres:5432/ktc4
DB_USERNAME=ktc4
DB_PASSWORD=ktc4local
BACKEND_PORT=8080

# ── Frontend ──────────────────────────────────────────
FRONTEND_PORT=3000
VITE_BACKEND_URL=http://localhost:8080
