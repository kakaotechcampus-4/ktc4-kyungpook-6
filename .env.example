# 로컬에서 Frontend + Backend + DB를 한 번에 띄울 때(docker-compose.yml) 쓰는 예시입니다.
#   cp .env.example .env
#
# .env는 .gitignore에 의해 커밋되지 않습니다.
# 아래 기본값은 docker-compose.yml에도 fallback으로 박혀 있어서,
# .env 파일 없이 `docker compose up -d --build` 만 해도 그대로 동작합니다.
#
# 🚨 운영(prod) 값은 여기에 적지 마세요. 이 repo는 public이고,
#    운영 값은 배포 환경의 환경변수로만 주입합니다.

# ── PostgreSQL ──────────────────────────────────────────
POSTGRES_DB=ktc4
POSTGRES_USER=ktc4
POSTGRES_PASSWORD=ktc4local
POSTGRES_PORT=5432

# ── Backend (Spring Boot 데이터소스) ─────────────────────
DB_URL=jdbc:postgresql://postgres:5432/ktc4
DB_USERNAME=ktc4
DB_PASSWORD=ktc4local
BACKEND_PORT=8080

# ── Frontend ──────────────────────────────────────────
FRONTEND_PORT=3000
VITE_BACKEND_URL=http://localhost:8080
# scripts/deploy.sh 가 frontend API 코드를 만들 때(Orval) 읽는 Swagger JSON 주소.
# 비워 두면 http://localhost:${BACKEND_PORT}/v3/api-docs 를 씁니다.
BACKEND_SWAGGER_URL=http://localhost:8080/v3/api-docs

# ── Backend 인증·외부 API ────────────────────────────
# AUTH_ENFORCE·JWT_SECRET·ADMIN_*·BIZNO·NTS 는 dev 오버라이드만 컨테이너에 넘깁니다.
# INTERNAL_API_KEY 와 AI_BASE_URL 은 base(docker-compose.yml)도 넘깁니다 — 둘은
# 로컬 compose 에서도 백엔드와 AI 를 잇는 데 필요합니다.
#   scripts/deploy.sh dev up -d --build  → 아래 값이 전부 backend 컨테이너에 들어감
#   docker compose up -d --build         → INTERNAL_API_KEY·AI_BASE_URL 만 들어감
# 값이 비어 있어도 배포는 멈추지 않습니다 — 빈 값이 그대로 컨테이너에 들어갑니다.
# dev·prod 서버는 각 서버의 .env 로 값을 관리합니다. 여기엔 로컬용 값만 넣으세요.
AUTH_ENFORCE=false
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 백엔드와 AI 가 같이 쓰는 키. 백엔드는 AI 가 보낸 X-API-KEY 를 확인하고,
# AI 를 부를 때도 같은 키를 싣는다. 비우면 양쪽 다 검사하지 않는다(로컬용).
INTERNAL_API_KEY=
BIZNO_API_KEY=
NTS_SERVICE_KEY=

# ── 백엔드 → AI ───────────────────────────────────────
# 비워 두면 docker-compose.yml 의 기본값 http://ai:8000 을 씁니다. compose 밖에서
# (gradle bootRun 등) 띄울 때만 http://localhost:8000 처럼 바꿔 적으세요.
AI_BASE_URL=
