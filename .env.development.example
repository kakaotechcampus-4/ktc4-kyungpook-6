# dev 서버에서만 쓰는 값입니다(docker-compose.dev.yml 이 읽음).
#   cp .env.development.example .env.development
#
# scripts/deploy.sh dev 가 루트 .env 위에 이 파일을 얹어 읽습니다 — 같은 키는 이 파일이 이깁니다.
# 로컬 `docker compose up`(base 만) 에서는 읽지 않습니다.
# .env 와 마찬가지로 커밋되지 않고, 배포는 checkout 의 clean: false 에 기대어 이 파일을 지우지 않습니다.

# ── 바깥에 여는 포트 ──────────────────────────────────
POSTGRES_PORT=5432
AI_PORT=8000

# ── 백엔드 → AI ───────────────────────────────────────
# 백엔드가 부를 AI 주소
AI_BASE_URL=http://ai:8000
