VERIFICATION_API_KEY=replace-with-a-long-random-server-key
STT_API_KEY=replace-me
LLM_API_KEY=replace-me
ELEVENLABS_API_KEY=replace-me
JEV_API_KEY=replace-me
ELEVENLABS_VOICE_ID=replace-with-your-voice-id
BACKEND_PORT=8000
BACKEND_BIND_HOST=127.0.0.1
STT_URL=https://your-stt-gateway.example/v1/audio/transcriptions
LLM_BASE_URL=https://your-llm-gateway.example/v1
JEV_URL=https://your-jev-gateway.example/v1/decisions
STT_MODEL=whisper-large-v3
LLM_MODEL=gpt-6.1-terra
TTS_MODEL=eleven_multilingual_v2
JEV_MODEL=typesafe/jev-latest
AT_PORT=/dev/ttyUSB2
VOICE_PORT=/dev/ttyUSB1
EP06_RESET_BEFORE_CALL=0
EP06_AUDIO_MODE=3
EP06_RX_GAIN=8192
EP06_MIC_GAIN=16384,1024
EP06_SIDETONE=0
SILENCE_SECONDS=0.6
SPEECH_RMS_THRESHOLD=500
MAX_UTTERANCE_SECONDS=20
INPUT_IDLE_SECONDS=25
# 기다려 달라는 요청에 응하는 한도. 기획 요구대로 60초가 상한이며 더 큰 값은 시작 시 실패한다.
WAIT_TIMEOUT_SECONDS=60
ANSWER_TIMEOUT=45
MAX_CALL_SECONDS=600
MAX_TURNS=120
QUEUE_CAPACITY=1000
PENDING_MAX_AGE_SECONDS=900
HTTP_TIMEOUT=20
JEV_TIMEOUT=4
# Jev 호출 연속 실패 허용 횟수. 이 횟수에 도달하면 통화를 중단한다.
JEV_MAX_FAILURES=3
JEV_THRESHOLD=0.7
JEV_STOP_THRESHOLD=0.9
JEV_READBACK_YES_THRESHOLD=0.9
# Host execution defaults (compose overrides these paths)
DATA_DIR=data
PERSONA_FILE=agent.json
MODEM_LOCK_FILE=/tmp/ep06-verification-modem.lock
