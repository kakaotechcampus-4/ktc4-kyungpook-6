# 로컬 개발 전용 예시입니다. 복사해서 .env로 만들어 쓰세요.
#   cp .env.example .env
#
# .env는 .gitignore에 이미 등록되어 커밋되지 않습니다.
# 아래 기본값은 docker-compose.yml에도 동일하게 fallback으로 박혀 있어서,
# .env 파일 없이 `docker compose up -d` 만 해도 그대로 동작합니다.
# 즉, 이 파일은 값을 바꾸고 싶을 때만 필요합니다 (예: 포트가 겹칠 때, 다른 DB에 붙일 때).
#
# 🚨 운영(prod) 값은 여기에 적지 마세요. 이 repo는 public이고, 운영 값은
#    배포 환경의 환경변수로만 주입합니다. (docker-compose.yml 상단 주석 참고)

# ── PostgreSQL (postgres 컨테이너) ──────────────────────
POSTGRES_DB=ktc4
POSTGRES_USER=ktc4
POSTGRES_PASSWORD=ktc4local
# 호스트에 노출할 포트. 로컬에 이미 5432를 쓰는 다른 postgres가 있다면 바꾸세요.
POSTGRES_PORT=5432

# ── Spring Boot 데이터소스 (backend 컨테이너 / application.yml) ──
# DB_URL의 host는 "postgres" (docker-compose 서비스명)입니다.
# docker compose로 backend를 띄우지 않고 로컬에서 직접 `gradle bootRun` 할 때는
# postgres 컨테이너가 127.0.0.1:5432 에 열려 있으므로 host를 localhost로 바꿔서 쓰세요.
DB_URL=jdbc:postgresql://postgres:5432/ktc4
DB_USERNAME=ktc4
DB_PASSWORD=ktc4local
# 호스트에 노출할 포트. 컨테이너 내부 포트(8080)는 고정이고, 이 값만 바뀝니다.
BACKEND_PORT=8080
